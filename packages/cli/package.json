{
  "name": "@payoutjp/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "payoutjp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "tsc -b tsconfig.build.json --clean"
  },
  "dependencies": {
    "@payoutjp/bank": "workspace:*",
    "@payoutjp/core": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
