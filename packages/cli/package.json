{
  "name": "@payoutjp/cli",
  "version": "0.1.0-alpha.1",
  "description": "Local-first PayoutJP command-line validator",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inthecradle/payoutjp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/inthecradle/payoutjp#readme",
  "bugs": {
    "url": "https://github.com/inthecradle/payoutjp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "payoutjp": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "tsc -b tsconfig.build.json --clean",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@payoutjp/bank": "workspace:*",
    "@payoutjp/core": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
